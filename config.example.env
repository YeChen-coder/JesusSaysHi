# Copy to config.local.env (git-ignored).
# The OpenAI key is read at runtime from an existing .env so it never lives in this repo.
JESUS_EXISTING_ENV=C:\path\to\ebo-ai-home\.env
# JESUS_EMBED_MODEL=text-embedding-3-small
# JESUS_REWRITE_MODEL=gpt-5.4-mini

# Voice (python jesus.py). Empty device names use the Windows defaults.
# JESUS_MIC_NAME=
# JESUS_SPEAKER_NAME=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# OPENAI_REALTIME_VOICE=cedar
# JESUS_BARGE_IN_MODE=local          # local | server | off
# JESUS_LOG_TRANSCRIPTS=false        # true writes spoken text into logs/ for debugging
# JESUS_MODERATION_MODEL=omni-moderation-latest
