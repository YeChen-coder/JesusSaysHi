# Copy to config.local.env (git-ignored).
# The OpenAI key is read at runtime from an existing .env so it never lives in this repo.
JESUS_EXISTING_ENV=C:\path\to\ebo-ai-home\.env
# JESUS_EMBED_MODEL=text-embedding-3-small
# JESUS_REWRITE_MODEL=gpt-5.4-mini

# Voice (python jesus.py). Empty device names use the Windows defaults.
# JESUS_MIC_NAME=
# JESUS_SPEAKER_NAME=
# OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
# OPENAI_REALTIME_VOICE=cedar
# JESUS_BARGE_IN_MODE=local          # local | server | off
# JESUS_LOG_TRANSCRIPTS=false        # true writes spoken text into logs/ for debugging
# JESUS_MODERATION_MODEL=omni-moderation-latest

# Avatar (docker compose --env-file config.local.env up -d --build --wait avatar)
# JESUS_AVATAR_ENABLED=true
# JESUS_AVATAR_URL=ws://127.0.0.1:19388/publish?source=jesus
# JESUS_AVATAR_CHARACTER=jesus            # or gentleman (SpecterSaysHi placeholder, assets in GPTSaysHi\assets)
# JESUS_AVATAR_MODE=stream80               # jesus is trained for 80 ms lookahead; gentleman uses fast
# JESUS_AVATAR_ASSETS=C:\path\to\JesusSaysHi\avatar_assets\jesus_20261021

# Retrieval backend: ragflow (default; ragflow/docker + ingest_ragflow.py) or local (phase 1 index)
# JESUS_RETRIEVER=ragflow
# JESUS_RAGFLOW_URL=http://127.0.0.1:19380
# JESUS_RAGFLOW_API_KEY=            # RAGFlow: avatar > API > create key
# JESUS_RAGFLOW_DATASET=BSB Gospels
# JESUS_RAGFLOW_EMBED=text-embedding-3-small@default@OpenAI   # model@instance@provider
# JESUS_RAGFLOW_RERANK=rerank-2.5@default@Voyage AI
# JESUS_RAGFLOW_KEYWORD_WEIGHT=0.3   # full-text share of the hybrid score
# JESUS_RAGFLOW_MIN_SCORE=0.30       # abstain below this reranked best score (eval/ragflow_results.md)
# JESUS_CRISIS_CHECK=true           # false turns off the crisis check outside the model

# Persona: memory (default; scripture recalled as his own sayings, see memory.py) or quote
# JESUS_PERSONA=memory
# JESUS_MEMORY_REWRITE=true          # rewrite what was said into themes before RAGFlow (+8 pts, ~1 s)
# JESUS_VOICE=ash
# JESUS_VOICE_SPEED=0.85
